SECRET_KEY=django-insecure-eduqash-pro-v2-super-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (PostgreSQL)
DB_NAME=eduqash_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Channels & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# AI Provider Configuration (Options: megallm, groq)
AI_PROVIDER=groq
MEGALLM_API_URL=https://api.megallm.uz/v1
MEGALLM_API_KEY=your_megallm_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot API (for free notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Payments (Free/Mock Provider setting)
FAKE_PAYMENT=True

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@eduqash.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EDUQASH PRO <noreply@eduqash.com>

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloud Storage Configuration
IMGBB_API_KEY=your_imgbb_api_key_here
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_STORAGE_BUCKET=eduqash-media

